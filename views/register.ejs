<%- include('partials/head', { title: 'Create Account' }) %>
<%- include('partials/navbar') %>

<main class="flex-1 flex items-center justify-center px-4 sm:px-6 lg:px-8 py-12">
  <div class="max-w-md w-full space-y-6">

    <!-- Header -->
    <div class="text-center">
      <div class="h-12 w-12 rounded-2xl bg-gradient-to-tr from-indigo-600 to-indigo-500 flex items-center justify-center text-white font-extrabold text-2xl shadow-md mx-auto mb-3">
        P
      </div>
      <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Join Pulse Today</h1>
      <p class="text-sm text-slate-500 mt-1">Connect with friends, colleagues, and the world</p>
    </div>

    <!-- Card -->
    <div class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm">
      <%- include('partials/flash-messages') %>

      <!-- Validation Error Callout -->
      <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
        <div class="mb-5 rounded-xl border border-rose-200 bg-rose-50 p-4 text-xs text-rose-800 space-y-1">
          <p class="font-bold">Please correct the following errors:</p>
          <ul class="list-disc list-inside space-y-0.5">
            <% errors.forEach(function(error) { %>
              <li><%= error.msg %></li>
            <% }); %>
          </ul>
        </div>
      <% } %>

      <form action="/register" method="POST" class="space-y-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <!-- Name -->
        <div>
          <label for="name" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Full Name</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            value="<%= typeof oldInput !== 'undefined' && oldInput.name ? oldInput.name : '' %>"
            placeholder="e.g. Alex Johnson"
            class="w-full px-3.5 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 focus:outline-none transition-all"
          >
        </div>

        <!-- Username -->
        <div>
          <label for="username" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Username</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400 text-sm">@</span>
            <input
              type="text"
              id="username"
              name="username"
              required
              pattern="^[a-zA-Z0-9_]+$"
              value="<%= typeof oldInput !== 'undefined' && oldInput.username ? oldInput.username : '' %>"
              placeholder="alexj"
              class="w-full pl-8 pr-3.5 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 focus:outline-none transition-all"
            >
          </div>
          <p class="text-[11px] text-slate-400 mt-1">Letters, numbers, and underscores only</p>
        </div>

        <!-- Email -->
        <div>
          <label for="email" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Email Address</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            value="<%= typeof oldInput !== 'undefined' && oldInput.email ? oldInput.email : '' %>"
            placeholder="alex@example.com"
            class="w-full px-3.5 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 focus:outline-none transition-all"
          >
        </div>

        <!-- Password -->
        <div>
          <label for="password" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            required
            minlength="6"
            placeholder="At least 6 characters"
            class="w-full px-3.5 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 focus:outline-none transition-all"
          >
        </div>

        <!-- Confirm Password -->
        <div>
          <label for="confirmPassword" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Confirm Password</label>
          <input
            type="password"
            id="confirmPassword"
            name="confirmPassword"
            required
            minlength="6"
            placeholder="Re-enter your password"
            class="w-full px-3.5 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 focus:outline-none transition-all"
          >
        </div>

        <button
          type="submit"
          class="w-full mt-2 py-2.5 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-1"
        >
          Create Account
        </button>
      </form>

      <div class="mt-6 pt-5 border-t border-slate-100 text-center text-xs text-slate-500">
        Already have an account?
        <a href="/login" class="font-semibold text-indigo-600 hover:text-indigo-800 transition-colors ml-1">
          Sign In
        </a>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>

