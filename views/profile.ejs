<%- include('partials/head', { title: `${profileUser.name} (@${profileUser.username})` }) %>
<%- include('partials/navbar') %>

<main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <%- include('partials/flash-messages') %>

  <!-- Profile Header Card -->
  <div class="bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-sm mb-8">
    <!-- Header Cover Banner -->
    <div class="h-36 sm:h-48 bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 relative"></div>

    <div class="px-6 pb-6 pt-0 relative">
      <div class="flex flex-col sm:flex-row items-center sm:items-end justify-between -mt-16 sm:-mt-20 mb-6 gap-4">
        
        <!-- Avatar & Name -->
        <div class="flex flex-col sm:flex-row items-center sm:items-end space-y-3 sm:space-y-0 sm:space-x-5 text-center sm:text-left">
          <div class="relative">
            <img
              src="<%= profileUser.profilePicture || `https://ui-avatars.com/api/?name=${encodeURIComponent(profileUser.name)}&background=6366f1&color=fff` %>"
              alt="<%= profileUser.name %>"
              class="h-28 w-28 sm:h-36 sm:sm:w-36 rounded-full object-cover border-4 border-white shadow-lg bg-white"
              onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(profileUser.name) %>&background=6366f1&color=fff'"
            >
          </div>
          <div class="sm:mb-2">
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 leading-tight">
              <%= profileUser.name %>
            </h1>
            <p class="text-sm font-medium text-slate-400">@<%= profileUser.username %></p>
          </div>
        </div>

        <!-- Action Buttons (Edit or Follow/Unfollow) -->
        <div class="sm:mb-2 flex items-center space-x-3">
          <% if (isOwnProfile) { %>
            <a
              href="/profile/edit"
              class="inline-flex items-center space-x-2 px-5 py-2.5 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-sm font-semibold shadow-sm transition-all"
            >
              <svg class="h-4 w-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
              <span>Edit Profile</span>
            </a>
          <% } else if (currentUser) { %>
            <form
              action="/users/<%= profileUser._id %>/<%= isFollowing ? 'unfollow' : 'follow' %>"
              method="POST"
              class="follow-form m-0"
              data-user-id="<%= profileUser._id %>"
            >
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button
                type="submit"
                class="follow-btn inline-flex items-center space-x-2 px-6 py-2.5 rounded-xl text-sm font-semibold transition-all shadow-sm <%= isFollowing ? 'bg-slate-100 text-slate-700 hover:bg-rose-50 hover:text-rose-600 border border-slate-300' : 'bg-indigo-600 text-white hover:bg-indigo-700' %>"
              >
                <%= isFollowing ? 'Following' : 'Follow' %>
              </button>
            </form>
          <% } %>
        </div>

      </div>

      <!-- Bio -->
      <% if (profileUser.bio && profileUser.bio.trim() !== '') { %>
        <p class="text-sm text-slate-700 max-w-2xl mb-5 leading-relaxed whitespace-pre-line">
          <%= profileUser.bio %>
        </p>
      <% } %>

      <!-- Meta info: Join Date & Statistics -->
      <div class="flex flex-wrap items-center gap-6 text-sm text-slate-500 pt-4 border-t border-slate-100">
        <div class="flex items-center space-x-1.5">
          <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>Joined <%= new Date(profileUser.createdAt).toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) %></span>
        </div>

        <div class="flex items-center space-x-1">
          <span class="font-bold text-slate-900"><%= postsCount %></span>
          <span>Posts</span>
        </div>

        <a href="/users/<%= profileUser.username %>/followers" class="hover:text-indigo-600 transition-colors flex items-center space-x-1">
          <span class="font-bold text-slate-900" id="followers-count-<%= profileUser._id %>"><%= followersCount %></span>
          <span>Followers</span>
        </a>

        <a href="/users/<%= profileUser.username %>/following" class="hover:text-indigo-600 transition-colors flex items-center space-x-1">
          <span class="font-bold text-slate-900"><%= followingCount %></span>
          <span>Following</span>
        </a>
      </div>

    </div>
  </div>

  <!-- User's Posts Section -->
  <div class="max-w-3xl mx-auto space-y-6">
    <div class="flex items-center justify-between border-b border-slate-200 pb-3">
      <h2 class="text-lg font-bold text-slate-900">Posts by <%= profileUser.name %></h2>
      <span class="text-xs text-slate-400"><%= posts.length %> total</span>
    </div>

    <% if (posts && posts.length > 0) { %>
      <div class="space-y-4">
        <% posts.forEach(function(post) { %>
          <%- include('partials/post-card', {
            post: {
              ...post.toObject(),
              isLiked: currentUser && post.likes.some(id => id.toString() === currentUser._id.toString()),
              commentCount: 0 // Will link to detail
            }
          }) %>
        <% }); %>
      </div>
    <% } else { %>
      <div class="bg-white rounded-2xl border border-slate-200 p-12 text-center shadow-sm">
        <svg class="h-12 w-12 text-slate-300 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
        <p class="text-sm font-semibold text-slate-700">No posts published yet</p>
        <p class="text-xs text-slate-400 mt-1">When <%= profileUser.name %> posts updates, they will show up here.</p>
      </div>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>

