<%- include('partials/head', { title: 'Edit Profile' }) %>
<%- include('partials/navbar') %>

<main class="flex-1 max-w-2xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="bg-white rounded-3xl border border-slate-200 p-8 shadow-sm">
    
    <div class="flex items-center justify-between pb-6 mb-6 border-b border-slate-100">
      <div>
        <h1 class="text-xl font-extrabold text-slate-900 tracking-tight">Edit Profile</h1>
        <p class="text-xs text-slate-500 mt-0.5">Customize your public information and avatar</p>
      </div>
      <a
        href="/users/<%= user.username %>"
        class="text-xs font-semibold text-slate-500 hover:text-slate-800 transition-colors"
      >
        Cancel
      </a>
    </div>

    <%- include('partials/flash-messages') %>

    <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
      <div class="mb-6 rounded-xl border border-rose-200 bg-rose-50 p-4 text-xs text-rose-800 space-y-1">
        <p class="font-bold">Please correct the following errors:</p>
        <ul class="list-disc list-inside space-y-0.5">
          <% errors.forEach(function(error) { %>
            <li><%= error.msg %></li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <form action="/profile/edit" method="POST" class="space-y-6">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <!-- Current Avatar Display -->
      <div class="flex items-center space-x-4">
        <img
          id="avatar-preview"
          src="<%= user.profilePicture || `https://ui-avatars.com/api/?name=${encodeURIComponent(user.name)}&background=6366f1&color=fff` %>"
          alt="<%= user.name %>"
          class="h-16 w-16 rounded-full object-cover border-2 border-indigo-500 shadow-sm"
          onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.name) %>&background=6366f1&color=fff'"
        >
        <div>
          <p class="text-sm font-semibold text-slate-800"><%= user.name %></p>
          <p class="text-xs text-slate-400">@<%= user.username %></p>
        </div>
      </div>

      <!-- Full Name -->
      <div>
        <label for="name" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Display Name</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          value="<%= user.name %>"
          class="w-full px-3.5 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 focus:outline-none transition-all"
        >
      </div>

      <!-- Bio -->
      <div>
        <label for="bio" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Bio (up to 250 characters)</label>
        <textarea
          id="bio"
          name="bio"
          rows="3"
          maxlength="250"
          placeholder="Tell the community a little bit about yourself..."
          class="w-full px-3.5 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 focus:outline-none transition-all resize-none"
        ><%= user.bio || '' %></textarea>
        <p class="text-[11px] text-slate-400 mt-1">Brief description about your interests, role, or hobbies</p>
      </div>

      <!-- Profile Picture URL -->
      <div>
        <label for="profilePicture" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Profile Picture URL</label>
        <input
          type="url"
          id="profilePicture"
          name="profilePicture"
          value="<%= user.profilePicture || '' %>"
          placeholder="https://images.unsplash.com/photo-..."
          class="w-full px-3.5 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 focus:outline-none transition-all"
          oninput="document.getElementById('avatar-preview').src = this.value || 'https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.name) %>&background=6366f1&color=fff'"
        >
        <p class="text-[11px] text-slate-400 mt-1">Leave empty to use automatic default initial avatar</p>
      </div>

      <div class="flex items-center justify-end space-x-3 pt-4 border-t border-slate-100">
        <a
          href="/users/<%= user.username %>"
          class="px-4 py-2 text-xs font-semibold text-slate-600 hover:text-slate-800 transition-colors"
        >
          Cancel
        </a>
        <button
          type="submit"
          class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs rounded-xl shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-indigo-400"
        >
          Save Changes
        </button>
      </div>
    </form>

  </div>
</main>

<%- include('partials/footer') %>

