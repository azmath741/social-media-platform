<%- include('partials/head', { title: 'Sign In' }) %>
<%- include('partials/navbar') %>

<main class="flex-1 flex items-center justify-center px-4 sm:px-6 lg:px-8 py-12">
  <div class="max-w-md w-full space-y-6">

    <!-- Header -->
    <div class="text-center">
      <div class="h-12 w-12 rounded-2xl bg-gradient-to-tr from-indigo-600 to-indigo-500 flex items-center justify-center text-white font-extrabold text-2xl shadow-md mx-auto mb-3">
        P
      </div>
      <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Welcome Back</h1>
      <p class="text-sm text-slate-500 mt-1">Sign in to your Pulse account</p>
    </div>

    <!-- Card -->
    <div class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm">
      <%- include('partials/flash-messages') %>

      <!-- Validation Error Callout -->
      <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
        <div class="mb-5 rounded-xl border border-rose-200 bg-rose-50 p-4 text-xs text-rose-800 space-y-1">
          <ul class="list-disc list-inside space-y-0.5">
            <% errors.forEach(function(error) { %>
              <li><%= error.msg %></li>
            <% }); %>
          </ul>
        </div>
      <% } %>

      <form action="/login" method="POST" class="space-y-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <!-- Identifier -->
        <div>
          <label for="identifier" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Username or Email</label>
          <input
            type="text"
            id="identifier"
            name="identifier"
            required
            value="<%= typeof oldInput !== 'undefined' && oldInput.identifier ? oldInput.identifier : '' %>"
            placeholder="your username or email"
            class="w-full px-3.5 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 focus:outline-none transition-all"
          >
        </div>

        <!-- Password -->
        <div>
          <label for="password" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            required
            placeholder="••••••••"
            class="w-full px-3.5 py-2 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 focus:outline-none transition-all"
          >
        </div>

        <button
          type="submit"
          class="w-full mt-2 py-2.5 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm rounded-xl shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-1"
        >
          Sign In
        </button>
      </form>

      <div class="mt-6 pt-5 border-t border-slate-100 text-center text-xs text-slate-500">
        Don't have an account?
        <a href="/register" class="font-semibold text-indigo-600 hover:text-indigo-800 transition-colors ml-1">
          Create one now
        </a>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>

