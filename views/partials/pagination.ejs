<% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
  <nav class="flex items-center justify-between border-t border-slate-200 px-4 sm:px-0 py-4 mt-6" aria-label="Pagination">
    <!-- Previous Button -->
    <div class="flex w-0 flex-1">
      <% if (currentPage > 1) { %>
        <a
          href="?page=<%= currentPage - 1 %>"
          class="inline-flex items-center border-t-2 border-transparent pt-2 pr-1 text-sm font-medium text-slate-500 hover:border-slate-300 hover:text-slate-700 transition-colors"
        >
          <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
          </svg>
          Previous
        </a>
      <% } else { %>
        <span class="inline-flex items-center border-t-2 border-transparent pt-2 pr-1 text-sm font-medium text-slate-300 cursor-not-allowed">
          <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
          </svg>
          Previous
        </span>
      <% } %>
    </div>

    <!-- Page Number Indicators -->
    <div class="hidden md:flex space-x-1">
      <% for (let p = 1; p <= totalPages; p++) { %>
        <% if (p === currentPage) { %>
          <span class="inline-flex items-center border-t-2 border-indigo-600 px-3 pt-2 text-sm font-bold text-indigo-600" aria-current="page">
            <%= p %>
          </span>
        <% } else if (p === 1 || p === totalPages || (p >= currentPage - 1 && p <= currentPage + 1)) { %>
          <a
            href="?page=<%= p %>"
            class="inline-flex items-center border-t-2 border-transparent px-3 pt-2 text-sm font-medium text-slate-500 hover:border-slate-300 hover:text-slate-700 transition-colors"
          >
            <%= p %>
          </a>
        <% } else if (p === currentPage - 2 || p === currentPage + 2) { %>
          <span class="inline-flex items-center border-t-2 border-transparent px-2 pt-2 text-sm font-medium text-slate-400">...</span>
        <% } %>
      <% } %>
    </div>

    <!-- Mobile Page Count -->
    <div class="flex md:hidden items-center pt-2 text-sm text-slate-600 font-medium">
      Page <%= currentPage %> of <%= totalPages %>
    </div>

    <!-- Next Button -->
    <div class="flex w-0 flex-1 justify-end">
      <% if (currentPage < totalPages) { %>
        <a
          href="?page=<%= currentPage + 1 %>"
          class="inline-flex items-center border-t-2 border-transparent pt-2 pl-1 text-sm font-medium text-slate-500 hover:border-slate-300 hover:text-slate-700 transition-colors"
        >
          Next
          <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      <% } else { %>
        <span class="inline-flex items-center border-t-2 border-transparent pt-2 pl-1 text-sm font-medium text-slate-300 cursor-not-allowed">
          Next
          <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </span>
      <% } %>
    </div>
  </nav>
<% } %>

