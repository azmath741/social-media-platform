<div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-base font-bold text-slate-900 tracking-tight">Who to Follow</h2>
    <a href="/search" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800 transition-colors">See all</a>
  </div>

  <% if (typeof suggestedUsers !== 'undefined' && suggestedUsers.length > 0) { %>
    <div class="space-y-4">
      <% suggestedUsers.forEach(function(suggested) { %>
        <div class="flex items-center justify-between gap-3">
          <a href="/users/<%= suggested.username %>" class="flex items-center space-x-3 group min-w-0">
            <img
              src="<%= suggested.profilePicture || `https://ui-avatars.com/api/?name=${encodeURIComponent(suggested.name)}&background=6366f1&color=fff` %>"
              alt="<%= suggested.name %>"
              class="h-10 w-10 rounded-full object-cover border border-slate-200 flex-shrink-0 group-hover:opacity-90 transition-opacity"
              onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(suggested.name) %>&background=6366f1&color=fff'"
            >
            <div class="min-w-0">
              <p class="text-sm font-semibold text-slate-800 truncate group-hover:text-indigo-600 transition-colors"><%= suggested.name %></p>
              <p class="text-xs text-slate-400 truncate">@<%= suggested.username %></p>
            </div>
          </a>

          <form action="/users/<%= suggested._id %>/follow" method="POST" class="follow-form flex-shrink-0" data-user-id="<%= suggested._id %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button
              type="submit"
              class="follow-btn text-xs font-semibold px-3 py-1.5 rounded-full bg-indigo-600 hover:bg-indigo-700 text-white transition-all shadow-sm"
            >
              Follow
            </button>
          </form>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <p class="text-xs text-slate-400 py-2">You're connected with everyone or no other users found yet!</p>
  <% } %>
</div>

