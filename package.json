{
  "name": "social-media-platform",
  "version": "1.0.0",
  "description": "A complete, modern social media platform built with Express, EJS, Tailwind CSS, and MongoDB",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "css:build": "tailwindcss -i ./src/input.css -o ./public/css/output.css --minify",
    "css:watch": "tailwindcss -i ./src/input.css -o ./public/css/output.css --watch",
    "dev:all": "concurrently \"npm run css:watch\" \"npm run dev\"",
    "seed": "node seed.js",
    "test": "node test-app.js && node test-http.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-flash": "^0.1.1",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "method-override": "^3.0.0",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "tailwindcss": "^3.4.17"
  }
}
